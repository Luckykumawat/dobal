# Google AI Studio -> Get API key
GEMINI_API_KEY=

# Optional model overrides
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
# Server-only key (secret / service_role). NEVER expose it with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Upstash Redis for rate limiting across all Vercel instances.
# (Vercel Marketplace -> Upstash for Redis sets KV_REST_API_URL / KV_REST_API_TOKEN automatically.)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
